<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RestoApp.Presentation.ViewModels"
             x:Class="RestoApp.Presentation.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto, *, Auto" Background="#0F172A">
        
        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Background="#1E293B" Padding="15,10" BoxShadow="0 4 10 0 #000000">
            <Grid ColumnDefinitions="Auto, *, Auto">
                
                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="8" Width="40" Height="40">
                        <TextBlock Text="🍽️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RestoApp" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="POS &amp; Gestión Gastronómica" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Interactive Demo RBAC Role Switcher & User Info -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
                    
                    <!-- Active User Badge -->
                    <Border Background="#0F172A" Padding="12,6" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="👤" FontSize="16" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser.NombreCompleto}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding CurrentUser.Dni, StringFormat='DNI: {0}'}" Foreground="#94A3B8" FontSize="11"/>
                            </StackPanel>
                            <Border Background="#2563EB" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser.Rol}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Interactive RBAC Switcher for Previewing Roles -->
                    <Border Background="#0F172A" Padding="10,4" CornerRadius="8" BorderBrush="#2563EB" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="⚡ RBAC Demo (Simular Rol):" Foreground="#60A5FA" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding DemoRoles}" 
                                      SelectedItem="{Binding CurrentUser.Rol}" 
                                      MinHeight="32" 
                                      FontSize="12"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Logout Button -->
                <Button Grid.Column="2" 
                        Command="{Binding LogoutCommand}" 
                        MinHeight="40" 
                        Padding="14,8" 
                        Background="#334155" 
                        Foreground="White" 
                        FontWeight="SemiBold" 
                        CornerRadius="8" 
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🚪" FontSize="14"/>
                        <TextBlock Text="Cerrar Sesión"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN BODY: Sidebar Navigation + Content Area -->
        <Grid Grid.Row="1" ColumnDefinitions="240, *">
            
            <!-- SIDEBAR NAVIGATION MENU -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0" Padding="12,20">
                <StackPanel Spacing="8">
                    
                    <TextBlock Text="MENÚ DE OPCIONES" Foreground="#64748B" FontSize="11" FontWeight="Bold" Margin="8,0,0,8"/>

                    <!-- 1. MESAS (Todos los roles) -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Mesas" 
                            MinHeight="48" CornerRadius="8" HorizontalAlignment="Stretch" Padding="12,8" Background="#2563EB" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="🍽️" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Estado Mesas" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 2. RESERVAS (Dueño, Gerente, Recepcionista) -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Reservas" 
                            IsVisible="{Binding CurrentUser.Rol, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter='Dueño,Gerente,Recepcionista'}"
                            MinHeight="48" CornerRadius="8" HorizontalAlignment="Stretch" Padding="12,8" Background="#334155" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="📅" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Reservas" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 3. PERSONAL (Dueño, Gerente) -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Personal" 
                            IsVisible="{Binding CurrentUser.Rol, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter='Dueño,Gerente'}"
                            MinHeight="48" CornerRadius="8" HorizontalAlignment="Stretch" Padding="12,8" Background="#334155" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="👥" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Personal / Turnos" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 4. CAJA Y PAGOS (Dueño, Gerente, Cajero) -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Caja" 
                            IsVisible="{Binding CurrentUser.Rol, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter='Dueño,Gerente,Cajero'}"
                            MinHeight="48" CornerRadius="8" HorizontalAlignment="Stretch" Padding="12,8" Background="#334155" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="💰" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Caja y Pagos" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 5. EVENTOS (Dueño, Gerente, Recepcionista) -->
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Eventos" 
                            IsVisible="{Binding CurrentUser.Rol, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter='Dueño,Gerente,Recepcionista'}"
                            MinHeight="48" CornerRadius="8" HorizontalAlignment="Stretch" Padding="12,8" Background="#334155" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="🎉" FontSize="18" VerticalAlignment="Center"/>
                            <TextBlock Text="Eventos Especiales" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Background="#334155" Height="1" Margin="0,15"/>

                    <Border Background="#0F172A" Padding="12" CornerRadius="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="🟢 Estado de Red:" Foreground="#10B981" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="LAN Conectado" Foreground="#94A3B8" FontSize="11"/>
                            <TextBlock Text="Resolución: Min 1024x768" Foreground="#64748B" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CENTRAL CONTENT AREA -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
        </Grid>

        <!-- GLOBAL NOTIFICATION BANNER OVERLAY -->
        <Border Grid.Row="2" 
                Background="#2563EB" 
                Padding="15,8" 
                IsVisible="{Binding HasNotification}">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="{Binding GlobalNotification}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" FontSize="13"/>
                <Button Grid.Column="1" Command="{Binding DismissNotificationCommand}" Content="✕ Ocultar" Background="Transparent" Foreground="White" FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
