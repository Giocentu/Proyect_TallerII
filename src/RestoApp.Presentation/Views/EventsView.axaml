<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RestoApp.Presentation.ViewModels"
             xmlns:models="clr-namespace:RestoApp.Presentation.Models"
             x:Class="RestoApp.Presentation.Views.EventsView"
             x:DataType="vm:EventsViewModel">

    <Grid RowDefinitions="Auto, *" Margin="20">
        
        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Módulo de Eventos Especiales y Promociones" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Catálogo de fechas festivas, cenas show y vinculación con reservas de clientes" FontSize="13" Foreground="#94A3B8"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="380, *">
            
            <!-- Event Creation Form -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,15,0">
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <TextBlock Text="Nuevo Evento Especial" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <Separator Background="#334155" Height="1"/>

                        <TextBlock Text="Nombre del Evento:" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewName}" MinHeight="44" Watermark="Ej. Día de la Madre..." VerticalContentAlignment="Center"/>

                        <TextBlock Text="Fecha del Evento:" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding NewFecha}" MinHeight="44" HorizontalAlignment="Stretch"/>

                        <TextBlock Text="Descripción / Promoción:" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewDescripcion}" AcceptsReturn="True" Height="100" TextWrapping="Wrap" Watermark="Detalles del menú, show o promociones..."/>

                        <!-- Submit Button -->
                        <Button Content="🎉 Registrar Evento" 
                                Command="{Binding CreateEventCommand}" 
                                MinHeight="48" 
                                Background="#8B5CF6" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                FontSize="15" 
                                CornerRadius="8" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Center" 
                                Margin="0,10,0,0"/>

                        <!-- Feedback -->
                        <Border Background="#0F172A" Padding="10" CornerRadius="6" IsVisible="{Binding HasFeedback}">
                            <TextBlock Text="{Binding FeedbackMessage}" Foreground="#60A5FA" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Events List / Catalog -->
            <ScrollViewer Grid.Column="1">
                <ItemsControl ItemsSource="{Binding Events}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:EventModel">
                            <Border Margin="8" Width="300" Padding="16" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    
                                    <!-- Header -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="{Binding Nombre}" FontSize="18" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Background="{Binding Activo, Converter={StaticResource BoolToBrushConverter}}" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="{Binding Activo, Converter={StaticResource BoolToTextConverter}}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Description -->
                                    <StackPanel Spacing="6" Margin="0,5">
                                        <TextBlock Text="{Binding FechaFormateada, StringFormat='📅 Fecha: {0}'}" Foreground="#60A5FA" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding Descripcion}" Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Linked Reservations Count -->
                                    <Border Background="#0F172A" Padding="10" CornerRadius="8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="Reservas Vinculadas:" Foreground="#94A3B8" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ReservasVinculadasCount, StringFormat='{}{0} reservas'}" Foreground="#10B981" FontWeight="Bold" FontSize="13"/>
                                        </Grid>
                                    </Border>

                                    <!-- Toggle Active Button -->
                                    <Button Command="{Binding $parent[UserControl].((vm:EventsViewModel)DataContext).ToggleEventActiveCommand}" 
                                            CommandParameter="{Binding}" 
                                            Content="Cambiar Estado Activo/Inactivo" 
                                            MinHeight="36" 
                                            Background="#334155" 
                                            Foreground="White" 
                                            CornerRadius="6" 
                                            HorizontalAlignment="Stretch" 
                                            HorizontalContentAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
